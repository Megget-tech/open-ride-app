<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <name>Rapid Fire</name>
  <author>Open Ride</author>
  <description>A ladder of effort that climbs and descends. Intervals progress from short to long and back, building power across the spectrum.</description>
  <sportType>bike</sportType>
  <category>Quick Sessions</category>
  <subcategory>Express</subcategory>
  <tags>
    <tag name="Intervals"/>
    <tag name="Progressive"/>
    <tag name="Quick"/>
  </tags>

  <workout>
    <Warmup Duration="240" PowerLow="0.40" PowerHigh="0.65" Cadence="90">
      <textevent timeoffset="0" message="Rapid Fire! A ladder workout that builds up and comes back down."/>
      <textevent timeoffset="120" message="Each step of the ladder gets longer, then shorter again."/>
      <textevent timeoffset="180" message="Get ready. The first rung is short and fast!"/>
    </Warmup>

    <SteadyState Duration="60" Power="0.70" Cadence="90">
      <textevent timeoffset="0" message="One minute to settle in before we start climbing."/>
    </SteadyState>

    <!-- Ladder UP -->
    <SteadyState Duration="15" Power="1.20" Cadence="105">
      <textevent timeoffset="0" message="Rung 1 - quick burst!"/>
    </SteadyState>
    <SteadyState Duration="15" Power="0.50" Cadence="80"/>

    <SteadyState Duration="30" Power="1.15" Cadence="100">
      <textevent timeoffset="0" message="Rung 2 - a bit longer now!"/>
    </SteadyState>
    <SteadyState Duration="30" Power="0.50" Cadence="80"/>

    <SteadyState Duration="45" Power="1.10" Cadence="98">
      <textevent timeoffset="0" message="Rung 3 - building duration! Stay strong!"/>
    </SteadyState>
    <SteadyState Duration="45" Power="0.50" Cadence="80"/>

    <SteadyState Duration="60" Power="1.05" Cadence="95">
      <textevent timeoffset="0" message="Rung 4 - the top! One minute at threshold!"/>
      <textevent timeoffset="30" message="Halfway up the ladder! Now we come back down."/>
    </SteadyState>
    <SteadyState Duration="60" Power="0.50" Cadence="80">
      <textevent timeoffset="0" message="Equal rest. Now the ladder descends."/>
    </SteadyState>

    <!-- Ladder DOWN -->
    <SteadyState Duration="45" Power="1.10" Cadence="98">
      <textevent timeoffset="0" message="Coming back down! 45 seconds!"/>
    </SteadyState>
    <SteadyState Duration="45" Power="0.50" Cadence="80"/>

    <SteadyState Duration="30" Power="1.15" Cadence="100">
      <textevent timeoffset="0" message="Shorter now! Pick up the intensity!"/>
    </SteadyState>
    <SteadyState Duration="30" Power="0.50" Cadence="80"/>

    <SteadyState Duration="15" Power="1.25" Cadence="108">
      <textevent timeoffset="0" message="Final rung! Maximum effort for 15 seconds!"/>
    </SteadyState>
    <SteadyState Duration="15" Power="0.50" Cadence="80"/>

    <SteadyState Duration="120" Power="0.55" Cadence="85">
      <textevent timeoffset="0" message="Ladder complete! Two minutes to recover."/>
      <textevent timeoffset="60" message="One more sweet spot block to finish it off."/>
    </SteadyState>

    <SteadyState Duration="240" Power="0.85" Cadence="90">
      <textevent timeoffset="0" message="Four minutes at sweet spot to close it out."/>
      <textevent timeoffset="120" message="Halfway! Strong and steady to the end."/>
      <textevent timeoffset="200" message="Almost there. Hold the power!"/>
    </SteadyState>

    <Cooldown Duration="180" PowerHigh="0.55" PowerLow="0.35" Cadence="80">
      <textevent timeoffset="0" message="Great work! Cooling down now."/>
      <textevent timeoffset="60" message="Ladder workouts build power across all durations."/>
      <textevent timeoffset="150" message="Rapid Fire complete!"/>
    </Cooldown>
  </workout>
</workout_file>

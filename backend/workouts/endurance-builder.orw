<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <name>Endurance Builder</name>
  <author>Open Ride</author>
  <description>A longer, steady-state workout designed to build your aerobic base. Perfect for recovery weeks or building endurance without high intensity. Keep your heart rate in zone 2-3.</description>
  <sportType>bike</sportType>
  <category>Endurance</category>
  <subcategory>Base Building</subcategory>
  <tags>
    <tag name="Endurance"/>
    <tag name="Zone 2"/>
    <tag name="Recovery"/>
  </tags>
  
  <workout>
    <!-- Warmup: 8 minutes -->
    <Warmup Duration="480" PowerLow="0.40" PowerHigh="0.60" Cadence="85">
      <textevent timeoffset="0" message="Welcome to Endurance Builder! Today is about steady, sustainable effort."/>
      <textevent timeoffset="120" message="This workout builds your aerobic engine - the foundation of all fitness."/>
      <textevent timeoffset="300" message="Keep your breathing relaxed. You should be able to hold a conversation."/>
      <textevent timeoffset="420" message="Warmup almost complete. Find your rhythm."/>
    </Warmup>
    
    <!-- First endurance block: 15 minutes at 65% -->
    <SteadyState Duration="900" Power="0.65" Cadence="90">
      <textevent timeoffset="0" message="15 minutes at endurance pace. Relax and enjoy the ride."/>
      <textevent timeoffset="180" message="Check your posture. Shoulders relaxed, core engaged."/>
      <textevent timeoffset="360" message="You're building mitochondria right now - the powerhouses of your muscles!"/>
      <textevent timeoffset="540" message="Halfway through this block. Stay smooth."/>
      <textevent timeoffset="720" message="Almost there. Consistent effort is key."/>
    </SteadyState>
    
    <!-- Slight tempo increase: 10 minutes at 70% -->
    <SteadyState Duration="600" Power="0.70" Cadence="90">
      <textevent timeoffset="0" message="Slight increase to 70% FTP. Still comfortable but working."/>
      <textevent timeoffset="180" message="This is the 'sweet spot' lower end - efficient training zone."/>
      <textevent timeoffset="360" message="Focus on pedaling in circles, not just pushing down."/>
      <textevent timeoffset="540" message="One minute left in this block!"/>
    </SteadyState>
    
    <!-- Back to base: 10 minutes at 60% -->
    <SteadyState Duration="600" Power="0.60" Cadence="85">
      <textevent timeoffset="0" message="Back to easier effort. Let your body recover while still working."/>
      <textevent timeoffset="300" message="Hydrate! Take a drink now."/>
      <textevent timeoffset="540" message="One more push coming up!"/>
    </SteadyState>
    
    <!-- Final tempo block: 8 minutes at 72% -->
    <SteadyState Duration="480" Power="0.72" Cadence="90">
      <textevent timeoffset="0" message="Final working block! 8 minutes at tempo."/>
      <textevent timeoffset="180" message="You're stronger than when you started. Keep believing!"/>
      <textevent timeoffset="360" message="Last two minutes. Finish strong!"/>
    </SteadyState>
    
    <!-- Cooldown: 6 minutes -->
    <Cooldown Duration="360" PowerHigh="0.55" PowerLow="0.35" Cadence="80">
      <textevent timeoffset="0" message="Excellent endurance work! Time to cool down."/>
      <textevent timeoffset="120" message="Spin easy. Let your muscles flush out."/>
      <textevent timeoffset="240" message="Great base-building session! These rides make you faster on race day."/>
      <textevent timeoffset="330" message="Workout complete! Recovery nutrition within 30 minutes is ideal. 🚴"/>
    </Cooldown>
  </workout>
</workout_file>

<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <name>Sweet Spot Surge</name>
  <author>Open Ride</author>
  <description>Sustained sweet spot riding punctuated by explosive surges. Builds FTP endurance while training your ability to respond to race-like accelerations.</description>
  <sportType>bike</sportType>
  <category>Medium Sessions</category>
  <subcategory>Standard</subcategory>
  <tags>
    <tag name="Sweet Spot"/>
    <tag name="Sprint"/>
    <tag name="Mixed"/>
  </tags>

  <workout>
    <Warmup Duration="300" PowerLow="0.40" PowerHigh="0.65" Cadence="85">
      <textevent timeoffset="0" message="Sweet Spot Surge! Steady power with explosive bursts."/>
      <textevent timeoffset="120" message="The surges simulate race attacks you need to cover."/>
      <textevent timeoffset="240" message="Get ready for sweet spot with a twist."/>
    </Warmup>

    <SteadyState Duration="60" Power="0.75" Cadence="90">
      <textevent timeoffset="0" message="One minute at tempo to settle in."/>
    </SteadyState>

    <!-- Block 1: SST with surges -->
    <SteadyState Duration="90" Power="0.88" Cadence="88">
      <textevent timeoffset="0" message="Block 1. Sweet spot. Controlled and strong."/>
    </SteadyState>
    <SteadyState Duration="20" Power="1.20" Cadence="105">
      <textevent timeoffset="0" message="SURGE! Cover the attack!"/>
    </SteadyState>
    <SteadyState Duration="90" Power="0.88" Cadence="88">
      <textevent timeoffset="0" message="Back to sweet spot. Absorb and recover."/>
    </SteadyState>
    <SteadyState Duration="20" Power="1.20" Cadence="105">
      <textevent timeoffset="0" message="SURGE! Respond again!"/>
    </SteadyState>
    <SteadyState Duration="90" Power="0.88" Cadence="88">
      <textevent timeoffset="0" message="Settle back in. Great surge response!"/>
    </SteadyState>
    <SteadyState Duration="20" Power="1.20" Cadence="105">
      <textevent timeoffset="0" message="One more SURGE this block!"/>
    </SteadyState>
    <SteadyState Duration="90" Power="0.88" Cadence="88">
      <textevent timeoffset="0" message="Block 1 finishing. Well done!"/>
    </SteadyState>

    <SteadyState Duration="180" Power="0.55" Cadence="85">
      <textevent timeoffset="0" message="Three minutes recovery. Block 2 is harder."/>
      <textevent timeoffset="120" message="Higher base power, bigger surges. You are ready!"/>
    </SteadyState>

    <!-- Block 2: Higher SST with surges -->
    <SteadyState Duration="90" Power="0.90" Cadence="90">
      <textevent timeoffset="0" message="Block 2! Higher sweet spot. Tighter margins."/>
    </SteadyState>
    <SteadyState Duration="20" Power="1.25" Cadence="105">
      <textevent timeoffset="0" message="BIG SURGE!"/>
    </SteadyState>
    <SteadyState Duration="90" Power="0.90" Cadence="90">
      <textevent timeoffset="0" message="Back to it. Stay composed."/>
    </SteadyState>
    <SteadyState Duration="20" Power="1.25" Cadence="105">
      <textevent timeoffset="0" message="SURGE! Quick acceleration!"/>
    </SteadyState>
    <SteadyState Duration="90" Power="0.90" Cadence="90">
      <textevent timeoffset="0" message="Strong! One more surge coming."/>
    </SteadyState>
    <SteadyState Duration="20" Power="1.25" Cadence="105">
      <textevent timeoffset="0" message="FINAL SURGE! All in!"/>
    </SteadyState>

    <SteadyState Duration="180" Power="0.55" Cadence="85">
      <textevent timeoffset="0" message="Recovery. One final sustained effort to close."/>
    </SteadyState>

    <SteadyState Duration="180" Power="0.92" Cadence="90">
      <textevent timeoffset="0" message="Three minutes at the top of sweet spot. No surges, just power!"/>
      <textevent timeoffset="90" message="Halfway! Hold this effort. Prove your fitness!"/>
      <textevent timeoffset="150" message="Almost there!"/>
    </SteadyState>

    <Cooldown Duration="240" PowerHigh="0.55" PowerLow="0.35" Cadence="80">
      <textevent timeoffset="0" message="Fantastic session! Cooling down."/>
      <textevent timeoffset="120" message="Surge training makes you unpredictable in races."/>
      <textevent timeoffset="200" message="Sweet Spot Surge complete!"/>
    </Cooldown>
  </workout>
</workout_file>
